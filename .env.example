# This project reads its database through a Cloudflare D1 binding (see
# .openai/hosting.json) and its signed-in identity from platform-injected
# request headers (app/chatgpt-auth.ts) — neither is configured via env vars,
# so there is nothing to set for local development.
#
# AI_API_KEY is reserved for Phase 4 (docs/GAP_ANALYSIS.md): the current
# report-generation service (lib/ai/report-service.ts) is a deterministic,
# no-external-call template fill and does not read this value yet.
AI_API_KEY=
